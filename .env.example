# Copy this file to .env and fill in the values you were given.
# Never commit .env. The app does not print these keys.

# JEV document classifier. The app calls https://api.typesafe.ai/v1/systemone.
# jev-latest is the stable alias. Pin jev-1.13.0 or jev-1.14.0 to stay on one version.
JEV_API_KEY=
JEV_MODEL=jev-latest

# API Model 1 is DeepSeek. The app calls https://api.deepseek.com/chat/completions.
# Thinking is disabled so the reply stays JSON.
MODEL_1_API_KEY=
MODEL_1_MODEL=deepseek-flash

# API Model 2 is Claude. The app calls https://api.anthropic.com/v1/messages.
MODEL_2_API_KEY=
MODEL_2_MODEL=claude-sonnet-5-5

# Local extraction model served by Ollama.
# The workflow does not switch to another model when this one fails.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:0.5b

# USD per 1,000,000 tokens. Both values in a pair are required, or that cost stays unavailable.
# Jev list price: $0.042 input, output free. https://docs.typesafe.ai/models
# DeepSeek flash off-peak, cache miss: $0.15 input, $0.60 output.
# Peak (Mon-Fri 09:00-12:00 and 14:00-18:00 Beijing) is double, and a cache hit is cheaper.
# https://api-docs.deepseek.com/quick_start/pricing
# Claude Sonnet 5.5: $2 input, $10 output. https://platform.claude.com/docs/en/about-claude/pricing
JEV_INPUT_USD_PER_MILLION=0.042
JEV_OUTPUT_USD_PER_MILLION=0
MODEL_1_INPUT_USD_PER_MILLION=0.15
MODEL_1_OUTPUT_USD_PER_MILLION=0.6
MODEL_2_INPUT_USD_PER_MILLION=2
MODEL_2_OUTPUT_USD_PER_MILLION=10

# Per-request read timeout in seconds. CPU inference can be slow.
REQUEST_TIMEOUT_SECONDS=180
